# Django Settings
SECRET_KEY=django-insecure-previene-plus-secret-key-for-research-demo-2026-secure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (SQLite)
# Database file will be created in the project root as db.sqlite3

# OpenAI AI Model Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5.6-luna
# Alternative standard models if gpt-5.6-luna is not yet assigned to your key:
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o

# Previene+ Application Configuration
CHATBOT_NAME=Previene+
CHATBOT_VERSION=1.0.0-research
INSTITUTION_NAME=I.E. Investigación Prevención ITS
ENABLE_FULL_MESSAGE_LOGGING=True
ENABLE_SIMULATION_MODE=True
